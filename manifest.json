{
  "manifest_version": 3,
  "name": "Gemini Browser Agent",
  "version": "0.1.0",
  "description": "Chat with Gemini and let it control your browser: read pages, click, type, scroll, navigate and manage tabs.",
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting",
    "activeTab",
    "storage",
    "debugger",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Gemini Browser Agent"
  }
}
